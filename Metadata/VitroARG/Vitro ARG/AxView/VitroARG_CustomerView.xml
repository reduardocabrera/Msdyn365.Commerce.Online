        return this.getLocation().ZipCode;
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayPhone</Name>
				<Source><![CDATA[
    public display LogisticsElectronicAddressLocator displayPhone()
    {
        LogisticsPostalAddress  logisticsPostalAddress;

        logisticsPostalAddress = DirParty::findPostalAddressByRole(this.RecId1, LogisticsLocationRoleType::Invoice);

        return logisticsPostalAddress.ARGPhone;
    }

]]></Source>
			</Method>
