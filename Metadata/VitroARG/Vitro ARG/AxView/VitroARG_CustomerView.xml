		<Methods>
			<Method>
				<Name>getLocation</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    private LogisticsPostalAddress getLocation()
    {
        DirPartyTable           dirPartyTable;
        DirPartyLocation        dirPartyLocation;
        LogisticsPostalAddress  logisticsPostalAddress;

        Name                    MyName;

        MyName = this.Name + '-Company';

        select firstonly dirPartyLocation
            join dirPartyTable
                where dirPartyTable.RecId == dirPartyLocation.Party
                && dirPartyLocation.IsPrimary == NoYes::Yes
                && dirPartyTable.RecId != this.RecId1
                && dirPartyTable.Name == MyName;

        logisticsPostalAddress = LogisticsPostalAddress::findByLocation(dirPartyLocation.Location);

        return logisticsPostalAddress;
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayAddress</Name>
				<Source><![CDATA[
    public display LogisticsAddressing displayAddress()
    {
        return this.getLocation().Address;
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayCity</Name>
				<Source><![CDATA[
